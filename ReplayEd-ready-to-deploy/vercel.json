
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "replayed-ready-to-deploy": {
      "root": "ReplayEd-ready-to-deploy",
      "framework": "vite"
    },
    "server": {
      "root": "ReplayEd-ready-to-deploy/server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ]
}

   "bindings": [
     { "type": "service", "service": "inventory", "format": "url", "env": "INVENTORY_URL" }
   ]
  
